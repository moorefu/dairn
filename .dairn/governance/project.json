{
  "schema_version": 1,
  "project": "dairn",
  "modules": [
    {
      "name": "app",
      "path": ".",
      "profiles": [
        "python"
      ],
      "checks": {
        "lint": {
          "argv": [
            "python",
            "tools/check-source.py",
            "lint"
          ],
          "cwd": "."
        },
        "unit": {
          "argv": [
            "python",
            "tools/check-source.py",
            "unit"
          ],
          "cwd": "."
        },
        "integration": {
          "argv": [
            "python",
            "tools/check-source.py",
            "integration"
          ],
          "cwd": "."
        },
        "build": {
          "argv": [
            "python",
            "tools/check-source.py",
            "build"
          ],
          "cwd": "."
        }
      }
    }
  ],
  "required_checks": {
    "L0": [
      "lint"
    ],
    "L1": [
      "lint",
      "unit"
    ],
    "L2": [
      "lint",
      "unit",
      "integration",
      "build"
    ]
  },
  "snapshot_exclusions": [
    "/.build/",
    "/dist/",
    "/runtime/",
    "/validation/",
    "/node_modules/",
    "__pycache__/",
    "*.pyc",
    "/.pytest_cache/",
    "/.ruff_cache/"
  ]
}
